# ==============================================================
# AI Financial Agent - 环境变量模板
# 使用方式：
#   cp .env.example .env     # 然后填入真实值
# 安全：.env 已被 .gitignore 忽略，切勿把真实密钥提交到版本库。
# 容器化部署：密钥通过 docker-compose 的 env_file: .env 注入，
#   .env 文件不进入镜像，也不被 .dockerignore 纳入构建上下文。
# ==============================================================

# ---- 必填 ----
# DeepSeek API Key：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 可选（缺失时相关数据源功能降级）----
# Tushare Token：https://tushare.pro（用于部分财务/新闻数据）
TUSHARE_TOKEN=your_tushare_token_here

# ---- 可选项（均有默认值，通常无需修改）----
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志目录（相对项目根或绝对路径）
LOG_DIR=logs
# SQLite 数据库文件路径（本地直接运行 uvicorn 时生效；
# Docker 容器内由 docker-compose 覆盖为 /data/agent_runs.db 并挂载持久化）
AGENT_DB_PATH=app/store/agent_runs.db
# uvicorn worker 数（Docker 部署生效，可用 docker compose run -e 覆盖）
UVICORN_WORKERS=2
